# Build
build/
*.o
*.a
*.so

# Data (large files)
data/*
!data/.gitkeep
!data/results/
data/results/*
!data/results/.gitkeep

# Output (generated files)
output/configs_su2/
output/configs_su3/
output/figures_*/
output/instanton/
*.dat
*.bin
conf.*

# Python
__pycache__/
*.pyc
*.egg-info/

# Notebooks
tests.ipynb

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.out
*.err

# Input files (user-specific, examples tracked)
input/*
!input/.gitkeep
!input/example_base_params.txt
!input/example_beta_scan.txt

# Output folder structure (keep dirs, ignore content)
!output/.gitkeep
