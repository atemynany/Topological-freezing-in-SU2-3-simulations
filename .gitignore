# Build
build/
build.broken/
build[0-9]*/
*.o
*.a
*.so

# Rust extension build artifacts
rust_analysis/target/
rust_analysis/Cargo.lock

# Data (large files)
data/*
!data/.gitkeep
!data/results/
data/results/*
!data/results/.gitkeep

# Output (generated files)
output/configs_su2/
output/configs_su3/
output/figures_*/
output/instanton/
*.dat
*.bin
conf.*

# Python
__pycache__/
*.pyc
*.egg-info/

# Notebooks
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# NFS temp files
.nfs*
.panfs*

# Logs
*.log
*.out
*.err

# Input files (user-specific, tracked files whitelisted)
input/*
!input/.gitkeep
!input/instanton.txt
!input/heatbath_input/
!input/heatbath_input/**
!input/heatbath_topcharge_input/
!input/heatbath_topcharge_input/**
!input/tests_input/
!input/tests_input/**

# Output folder structure (keep dirs, ignore content)
!output/.gitkeep
